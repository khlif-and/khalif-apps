<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background: Black Color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
        </shape>
    </item>
    
    <!-- Foreground: The White Logo with padding to keep it centered and safe -->
    <item android:drawable="@drawable/ic_logo_khalif"
          android:top="16dp"
          android:bottom="16dp"
          android:left="16dp"
          android:right="16dp"
          android:gravity="center" />
</layer-list>
